#pragma once
#ifndef SLIM__VALUE__HPP__ONLY
#define SLIM__VALUE__HPP__ONLY
#include <any>
#include <concepts>
#include <cstdint>
#include <optional>
#include <string>
#include <string_view>
#include <type_traits>
#include <unordered_map>
#include <variant>
#include <vector>

#define SLIMVALUE_VERSION "@SLIMVALUE_VERSION@"
#define SLIMVALUE_GIT_HASH "@SLIMVALUE_GIT_HASH@"

namespace slim {
	using slim_coordinates = std::pair<int, int>;
	using slim_storage_container = std::vector<uint8_t>;
	struct AnyValue {
		AnyValue() = default;

		template <typename _T>
		AnyValue(_T&& _v) {
			using U = std::decay_t<_T>;

			if constexpr(std::is_same_v<U, char>) {
				__value = std::string(1, _v);
			}
			else if constexpr(std::is_constructible_v<std::string, U>) {
				__value = std::string(_v);
			}
			else if constexpr(std::constructible_from<Variant, U>) {
				__value = std::forward<_T>(_v);
			}
		}

		explicit operator bool() const {
			return std::visit([](auto&& _v)-> bool {
				using _T = std::decay_t<decltype(_v)>;

				if constexpr(std::is_same_v<_T, std::monostate>) {
					return false;
				}
				else if constexpr(std::is_same_v<_T, bool>) {
					return _v;
				}
				else if constexpr(std::is_arithmetic_v<_T>) {
					return _v != 0;
				}
				else if constexpr(std::is_same_v<_T, std::string>) {
					return !_v.empty();
				}
				else if constexpr(std::is_same_v<_T, slim_storage_container>) {
					return !_v.empty();
				}
				else {
					return true;
				}
			}, __value);
		}

		bool operator==(const AnyValue& _other) const {
			return __value == _other.__value;
		}

		bool operator!=(const AnyValue& _other) const {
			return __value != _other.__value;
		}

		template <typename _T>
		bool operator==(const _T& _rhs) const {
			using U = std::decay_t<_T>;

			return std::visit([&](auto&& _v) -> bool {
				using _V = std::decay_t<decltype(_v)>;

				if constexpr(std::is_same_v<_V, std::string>) {
					if constexpr(std::is_same_v<U, std::string>) {
						return _v == _rhs;
					}
					else if constexpr(std::is_constructible_v<std::string_view, U>) {
						return _v == std::string_view(_rhs);
					}
					else {
						return false;
					}
				}
				else if constexpr(std::is_integral_v<_V> && std::is_integral_v<U>) {
					return static_cast<int64_t>(_v) == static_cast<int64_t>(_rhs);
				}
				else if constexpr(std::is_floating_point_v<_V> && std::is_floating_point_v<U>) {
					return static_cast<double>(_v) == static_cast<double>(_rhs);
				}
				else if constexpr((std::is_arithmetic_v<_V> && std::is_arithmetic_v<U>)) {
					return static_cast<double>(_v) == static_cast<double>(_rhs);
				}
				else if constexpr(std::is_same_v<_V, U>) {
					return _v == _rhs;
				}
				else {
					return false;
				}
			}, __value);
		}

		template <typename _T>
		bool operator!=(const _T& _rhs) const {
			using U = std::decay_t<_T>;

			return std::visit([&](auto&& _v) -> bool {
				using _V = std::decay_t<decltype(_v)>;

				if constexpr(std::is_same_v<_V, std::string>) {
					if constexpr(std::is_same_v<U, std::string>) {
						return _v != _rhs;
					}
					else if constexpr(std::is_constructible_v<std::string_view, U>) {
						return _v != std::string_view(_rhs);
					}
					else {
						return false;
					}
				}
				else if constexpr(std::is_integral_v<_V> && std::is_integral_v<U>) {
					return static_cast<int64_t>(_v) != static_cast<int64_t>(_rhs);
				}
				else if constexpr(std::is_floating_point_v<_V> && std::is_floating_point_v<U>) {
					return static_cast<double>(_v) != static_cast<double>(_rhs);
				}
				else if constexpr((std::is_arithmetic_v<_V> && std::is_arithmetic_v<U>)) {
					return static_cast<double>(_v) != static_cast<double>(_rhs);
				}
				else if constexpr(std::is_same_v<_V, U>) {
					return _v != _rhs;
				}
				else {
					return false;
				}
			}, __value);
		}

		// --- exact-type named getters ---

		template <typename _T>
		_T& get() {
			return std::get<_T>(__value);
		}

		template <typename _T>
		const _T& get() const {
			return std::get<_T>(__value);
		}

		bool get_bool() const {
			return get<bool>();
		}

		slim_coordinates get_coordinates() const {
			return get<slim_coordinates>();
		}

		double get_double() const {
			return get<double>();
		}

		float get_float() const {
			return get<float>();
		}

		int get_int() const {
			return get<int>();
		}

		long get_long() const {
			return get<long>();
		}

		long double get_long_double() const {
			return get<long double>();
		}

		long long get_long_long() const {
			return get<long long>();
		}

		slim_storage_container& get_storage_container() {
			return get<slim_storage_container>();
		}

		const slim_storage_container& get_storage_container() const {
			return get<slim_storage_container>();
		}

		const std::string& get_string() const {
			return get<std::string>();
		}

		unsigned get_unsigned() const {
			return get<unsigned>();
		}

		unsigned long get_unsigned_long() const {
			return get<unsigned long>();
		}

		unsigned long long get_unsigned_long_long() const {
			return get<unsigned long long>();
		}

		// --- safe cross-type numeric getters ---
		// Cast across integral/float families without caring about exact stored type.
		// Throw std::bad_variant_access if the stored type is incompatible.

		double get_as_double() const {
			return std::visit([](auto&& _v) -> double {
				using _T = std::decay_t<decltype(_v)>;
				if constexpr(std::is_arithmetic_v<_T> && !std::is_same_v<_T, std::monostate>) {
					return static_cast<double>(_v);
				}
				else {
					throw std::bad_variant_access{};
				}
			}, __value);
		}

		long double get_as_float() const {
			return std::visit([](auto&& _v) -> long double {
				using _T = std::decay_t<decltype(_v)>;
				if constexpr(std::is_floating_point_v<_T>) {
					return static_cast<long double>(_v);
				}
				else {
					throw std::bad_variant_access{};
				}
			}, __value);
		}

		int64_t get_as_int64() const {
			return std::visit([](auto&& _v) -> int64_t {
				using _T = std::decay_t<decltype(_v)>;
				if constexpr(std::is_integral_v<_T> && !std::is_same_v<_T, std::monostate>) {
					return static_cast<int64_t>(_v);
				}
				else {
					throw std::bad_variant_access{};
				}
			}, __value);
		}

		uint64_t get_as_uint64() const {
			return std::visit([](auto&& _v) -> uint64_t {
				using _T = std::decay_t<decltype(_v)>;
				if constexpr(std::is_integral_v<_T> && !std::is_same_v<_T, std::monostate>) {
					return static_cast<uint64_t>(_v);
				}
				else {
					throw std::bad_variant_access{};
				}
			}, __value);
		}

		bool has_value() const {
			return !std::holds_alternative<std::monostate>(__value);
		}

		template <typename _T>
		bool is() const {
			return std::holds_alternative<_T>(__value);
		}

		std::string to_string() const {
			return std::visit([](auto&& _v) -> std::string {
				using _T = std::decay_t<decltype(_v)>;

				if constexpr(std::is_same_v<_T, std::monostate>) {
					return "";
				}
				else if constexpr(std::is_same_v<_T, bool>) {
					return _v ? "true" : "false";
				}
				else if constexpr(std::is_integral_v<_T>) {
					return std::to_string(_v);
				}
				else if constexpr(std::is_floating_point_v<_T>) {
					return std::to_string(_v);
				}
				else if constexpr(std::is_same_v<_T, std::string>) {
					return _v;
				}
				else if constexpr(std::is_same_v<_T, slim_storage_container>) {
					return std::string(_v.begin(), _v.end());
				}
				else {
					return "";
				}
			}, __value);
		}

		// --- optional / non-throwing getters ---
		// Return std::nullopt if the stored type doesn't match.

		std::optional<bool> try_bool() const {
			if(is<bool>()) {
				return get<bool>();
			}
			return std::nullopt;
		}

		std::optional<slim_coordinates> try_coordinates() const {
			if(is<slim_coordinates>()) {
				return get<slim_coordinates>();
			}
			return std::nullopt;
		}

		std::optional<double> try_double() const {
			return std::visit([](auto&& _v) -> std::optional<double> {
				using _T = std::decay_t<decltype(_v)>;
				if constexpr(std::is_arithmetic_v<_T> && !std::is_same_v<_T, std::monostate>) {
					return static_cast<double>(_v);
				}
				return std::nullopt;
			}, __value);
		}

		std::optional<int64_t> try_int64() const {
			return std::visit([](auto&& _v) -> std::optional<int64_t> {
				using _T = std::decay_t<decltype(_v)>;
				if constexpr(std::is_integral_v<_T> && !std::is_same_v<_T, std::monostate>) {
					return static_cast<int64_t>(_v);
				}
				return std::nullopt;
			}, __value);
		}

		std::optional<slim_storage_container> try_storage_container() const {
			if(is<slim_storage_container>()) {
				return get<slim_storage_container>();
			}
			return std::nullopt;
		}

		std::optional<std::string> try_string() const {
			if(is<std::string>()) {
				return get<std::string>();
			}
			return std::nullopt;
		}

		// --- value_or helpers ---
		// Return the stored value cast to _T, or a fallback if types are incompatible.

		template <typename _T>
		_T value_or(_T _fallback) const {
			return std::visit([&](auto&& _v) -> _T {
				using _V = std::decay_t<decltype(_v)>;
				if constexpr(std::is_convertible_v<_V, _T>) {
					return static_cast<_T>(_v);
				}
				else {
					return _fallback;
				}
			}, __value);
		}

		std::string value_or(std::string _fallback) const {
			if(is<std::string>()) {
				return get<std::string>();
			}
			return _fallback;
		}

		std::string value_or(const char* _fallback) const {
			if(is<std::string>()) {
				return get<std::string>();
			}
			return std::string(_fallback);
		}

		private:
			using Variant = std::variant<
				std::monostate,
				bool,
				int,
				long,
				long long,
				unsigned,
				unsigned long,
				unsigned long long,
				float,
				double,
				long double,
				std::string,
				slim_storage_container,
				slim_coordinates
			>;
			Variant __value;
	};

	struct ErrorInfo {
		ErrorInfo() = default;
		ErrorInfo(int _code) : __code(_code) {}
		ErrorInfo(std::string_view _message) : __message(_message) {}
		ErrorInfo(int _code, std::string_view _message) : __code(_code), __message(_message) {}

		int code() const {
			return __code.value_or(-1);
		}

		bool has_error() const {
			return __code.has_value() || __message.has_value();
		}

		bool has_error_code() const {
			return __code.has_value();
		}

		bool has_error_message() const {
			return __message.has_value();
		}

		std::string message() const {
			return __message.value_or("");
		}

		std::string message_or(std::string _or_message = "") const {
			return __message.value_or(_or_message);
		}

		private:
			std::optional<int> __code;
			std::optional<std::string> __message;
	};

	struct SlimMap {
		SlimMap() = default;

		void clear() {
			__map.clear();
		}

		AnyValue& create(std::string_view _key) {
			return __map[std::string(_key)];
		}

		std::unordered_map<std::string, AnyValue>& get() {
			return __map;
		}

		const std::unordered_map<std::string, AnyValue>& get() const {
			return __map;
		}

		AnyValue& get(std::string_view _key) {
			return __map.at(std::string(_key));
		}

		const AnyValue& get(std::string_view _key) const {
			return __map.at(std::string(_key));
		}

		bool has(std::string_view _key) const {
			return __map.contains(std::string(_key));
		}

		void remove(std::string_view _key) {
			__map.erase(std::string(_key));
		}

		void set(std::string_view _key, const AnyValue& _value) {
			__map[std::string(_key)] = _value;
		}

		void set(std::string_view _key, AnyValue&& _value) {
			__map[std::string(_key)] = std::move(_value);
		}

		std::size_t size() const {
			return __map.size();
		}

		private:
			std::unordered_map<std::string, AnyValue> __map;
	};

	struct SlimMultiMap {
		SlimMultiMap() = default;

		void clear() {
			__map.clear();
		}

		AnyValue& create(std::string_view _key) {
			return __map.emplace(std::string(_key), AnyValue{})->second;
		}

		std::unordered_multimap<std::string, AnyValue>& get() {
			return __map;
		}

		const std::unordered_multimap<std::string, AnyValue>& get() const {
			return __map;
		}

		std::pair<
			std::unordered_multimap<std::string, AnyValue>::iterator,
			std::unordered_multimap<std::string, AnyValue>::iterator
		> get(std::string_view _key) {
			return __map.equal_range(std::string(_key));
		}

		std::pair<
			std::unordered_multimap<std::string, AnyValue>::const_iterator,
			std::unordered_multimap<std::string, AnyValue>::const_iterator
		> get(std::string_view _key) const {
			return __map.equal_range(std::string(_key));
		}

		bool has(std::string_view _key) const {
			return __map.find(std::string(_key)) != __map.end();
		}

		void remove(std::string_view _key) {
			__map.erase(std::string(_key));
		}

		void set(std::string_view _key, AnyValue&& _value) {
			__map.emplace(std::string(_key), std::move(_value));
		}

		template <typename _T>
		void set(std::string_view _key, _T&& _value) {
			using U = std::decay_t<_T>;

			if constexpr(std::is_same_v<U, std::string_view>) {
				__map.emplace(std::string(_key), AnyValue(std::string(_value)));
			}
			else {
				__map.emplace(std::string(_key), AnyValue(std::forward<_T>(_value)));
			}
		}

		std::size_t size() const {
			return __map.size();
		}

		private:
			std::unordered_multimap<std::string, AnyValue> __map;
	};

	struct SlimValue {
		SlimValue() = default;
		SlimValue(const SlimValue& other) = default;
		SlimValue(SlimValue&&) noexcept = default;

		template <typename _T>
		requires(
			!std::same_as<std::decay_t<_T>, SlimValue> &&
			!std::same_as<std::decay_t<_T>, AnyValue> &&
			!std::same_as<std::decay_t<_T>, ErrorInfo> &&
			std::constructible_from<AnyValue, _T>)
		SlimValue(_T&& _value) : __value(std::forward<_T>(_value)), __error() {}

		template <typename _T, std::enable_if_t<std::is_same_v<std::decay_t<_T>, AnyValue>, int> = 0>
		SlimValue(_T&& _value) : __value(std::forward<_T>(_value)), __error() {}

		template <typename _T, std::enable_if_t<std::is_same_v<std::decay_t<_T>, ErrorInfo>, int> = 0>
		SlimValue(_T&& _error) : __value(), __error(std::forward<_T>(_error)) {}

		SlimValue(AnyValue _value, ErrorInfo _error) : __value(std::move(_value)), __error(std::move(_error)) {}

		SlimValue& operator=(const SlimValue& _other) {
			if(this != &_other) {
				__value = _other.__value;
				__error = _other.__error;
				__maps = _other.__maps;
				__multi_maps = _other.__multi_maps;
			}
			return *this;
		}

		SlimValue& operator=(SlimValue&& _other) noexcept {
			if(this != &_other) {
				__value = std::move(_other.__value);
				__error = std::move(_other.__error);
				__maps = std::move(_other.__maps);
				__multi_maps = std::move(_other.__multi_maps);
			}
			return *this;
		}

		template <typename _T>
		requires(
			!std::same_as<std::decay_t<_T>, SlimValue> &&
			!std::same_as<std::decay_t<_T>, AnyValue> &&
			!std::same_as<std::decay_t<_T>, ErrorInfo> &&
			std::constructible_from<AnyValue, _T>
		)
		SlimValue& operator=(_T&& _value) {
			__value = AnyValue(std::forward<_T>(_value));
			return *this;
		}

		explicit operator bool() const {
			return static_cast<bool>(__value);
		}

		bool operator!() const {
			return !static_cast<bool>(__value);
		}

		bool operator==(const SlimValue& _other) const {
			return __value == _other.__value;
		}

		bool operator!=(const SlimValue& _other) const {
			return __value != _other.__value;
		}

		template <typename _T>
		bool operator==(const _T& _rhs) const {
			return __value == _rhs;
		}

		template <typename _T>
		bool operator!=(const _T& _rhs) const {
			return __value != _rhs;
		}

		template <typename _T>
		_T& get() {
			return __value.get<_T>();
		}

		template <typename _T>
		const _T& get() const {
			return __value.get<_T>();
		}

		// --- safe cross-type numeric getters ---

		double get_as_double() const {
			return __value.get_as_double();
		}

		long double get_as_float() const {
			return __value.get_as_float();
		}

		int64_t get_as_int64() const {
			return __value.get_as_int64();
		}

		uint64_t get_as_uint64() const {
			return __value.get_as_uint64();
		}

		// --- exact-type named getters ---

		bool get_bool() const {
			return __value.get_bool();
		}

		slim_coordinates get_coordinates() const {
			return __value.get_coordinates();
		}

		double get_double() const {
			return __value.get_double();
		}

		const ErrorInfo& get_error() const {
			return __error;
		}

		float get_float() const {
			return __value.get_float();
		}

		int get_int() const {
			return __value.get_int();
		}

		long get_long() const {
			return __value.get_long();
		}

		long double get_long_double() const {
			return __value.get_long_double();
		}

		long long get_long_long() const {
			return __value.get_long_long();
		}

		SlimMap& get_map(std::string_view _key) {
			if(!__maps) {
				__maps.emplace();
			}
			return (*__maps)[std::string(_key)];
		}

		const SlimMap& get_map(std::string_view _key) const {
			return __maps.value().at(std::string(_key));
		}

		SlimMultiMap& get_multi_map(std::string_view _key) {
			if(!__multi_maps) {
				__multi_maps.emplace();
			}
			return (*__multi_maps)[std::string(_key)];
		}

		slim_storage_container& get_storage_container() {
			return __value.get_storage_container();
		}

		const slim_storage_container& get_storage_container() const {
			return __value.get_storage_container();
		}

		const std::string& get_string() const {
			return __value.get_string();
		}

		unsigned get_unsigned() const {
			return __value.get_unsigned();
		}

		unsigned long get_unsigned_long() const {
			return __value.get_unsigned_long();
		}

		unsigned long long get_unsigned_long_long() const {
			return __value.get_unsigned_long_long();
		}

		bool has_error() const {
			return __error.has_error();
		}

		bool has_map(std::string_view _key) const {
			return __maps && __maps->contains(std::string(_key));
		}

		bool has_maps() const {
			return __maps.has_value();
		}

		bool has_multi_map(std::string_view _key) const {
			return __multi_maps && __multi_maps->contains(std::string(_key));
		}

		bool has_multi_maps() const {
			return __multi_maps.has_value();
		}

		bool has_value() const {
			return __value.has_value();
		}

		template <typename _T>
		bool is() const {
			return __value.is<_T>();
		}

		void set_error(const int _code) {
			__error = ErrorInfo(_code);
		}

		void set_error(std::string_view _message) {
			__error = ErrorInfo(_message);
		}

		void set_error(const int _code, std::string_view _message) {
			__error = ErrorInfo(_code, _message);
		}

		void set_error(const ErrorInfo& _error) {
			__error = _error;
		}

		void set_error(ErrorInfo&& _error) {
			__error = std::move(_error);
		}

		void set_value(const AnyValue& _value) {
			__value = _value;
		}

		void set_value(AnyValue&& _value) {
			__value = std::move(_value);
		}

		std::string to_string() const {
			return __value.to_string();
		}

		// --- optional / non-throwing getters ---

		std::optional<bool> try_bool() const {
			return __value.try_bool();
		}

		std::optional<slim_coordinates> try_coordinates() const {
			return __value.try_coordinates();
		}

		std::optional<double> try_double() const {
			return __value.try_double();
		}

		std::optional<int64_t> try_int64() const {
			return __value.try_int64();
		}

		std::optional<slim_storage_container> try_storage_container() const {
			return __value.try_storage_container();
		}

		std::optional<std::string> try_string() const {
			return __value.try_string();
		}

		template <typename _T>
		auto value_or(_T&& _fallback) const {
			return __value.value_or(std::forward<_T>(_fallback));
		}

		private:
			AnyValue __value;
			ErrorInfo __error;

			std::optional<std::unordered_map<std::string, SlimMap>> __maps;
			std::optional<std::unordered_map<std::string, SlimMultiMap>> __multi_maps;
	};
}
#endif
